APP_NAME="EduLearn"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=https://lms.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=acumen_lms
DB_USERNAME=acumen
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_DAILY_LIMIT=10

LMS_LOGIN_LOCKOUT_MINUTES=15

# Video lectures. The application limit is separate from the 10 MB study-material limit,
# which must not be raised. PHP (upload_max_filesize/post_max_size) and the web server
# (client_max_body_size) must allow at least as much; see docs/video-operations.md.
VIDEO_MAX_KILOBYTES=512000
VIDEO_POSTER_MAX_KILOBYTES=2048
VIDEO_CAPTION_MAX_KILOBYTES=1024
VIDEO_TRANSCRIPT_MAX_CHARS=200000
# Optional: serve video bytes through an internal nginx location instead of PHP.
# Leave empty to stream from PHP, which works on any host.
VIDEO_X_ACCEL_PREFIX=
